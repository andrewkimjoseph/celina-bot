{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celina-bot",
  "account_id": "123527d9c3c3ad3e1fa18b2aff52dd01",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bot.usecelina.xyz",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "dde0cba2e2da4b37855883d8564931af"
    }
  ]
}
