{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celina-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "BOT_SESSIONS",
      "id": "local-bot-sessions"
    }
  ]
}
